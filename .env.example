# Copy to .env.local and fill in your own EmailJS values (https://www.emailjs.com/).
# Never commit .env.local.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional. Recommended: leave empty and set the recipient inside the EmailJS template
# itself, so the browser cannot choose where e-mails are sent.
NEXT_PUBLIC_COORDINATOR_EMAIL=
